PORT=3001
# Yandex Games (*.yandex.ru/com/net) and GamePush (*.gamepush.com, *.pikabu.ru) origins are accepted dynamically
ALLOWED_ORIGINS=https://wheee.io,https://ru.wheee.io
VITE_API_URL=https://api.wheee.io
# RECONNECT_GRACE_MS=30000

# Auth
JWT_SECRET=change-me-to-a-random-64-char-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_CALLBACK_URL=https://api.wheee.io/api/auth/callback
CLIENT_ORIGIN=https://wheee.io
COOKIE_DOMAIN=.wheee.io

# Telegram Mini App (optional — leave empty to disable TG auth)
TG_BOT_TOKEN=
# Secret for the bot webhook (/start replies); empty = webhook route disabled.
# Set the same value when calling setWebhook (secret_token parameter).
TG_WEBHOOK_SECRET=

# Yandex Games (optional — enables signature verification for player auth)
# Get from Yandex Games Console → In-app purchases → Settings
YANDEX_SECRET_KEY=

# Database (SQLite file path inside container)
DB_PATH=/data/wheee.db

# Analytics: token for GET /api/events/summary (leave empty to keep it closed)
STATS_TOKEN=

# Telegram challenge links: direct Mini App link
# (client build var; defaults to https://t.me/wheee_game_bot/play in code)
VITE_TG_APP_URL=

# Queue alerts: Telegram chat id to ping when a player waits alone in the queue
# (send /chatid to @wheee_game_bot to learn yours; empty = alerts off)
QUEUE_ALERT_CHAT_ID=

# Queue alerts: minimum ms between pings (default 60000)
QUEUE_ALERT_COOLDOWN_MS=
